PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Never expose this as VITE_* or commit it.
SUPABASE_SECRET_KEY=your-rotated-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional: approval email delivery
# For Resend, use a verified sender address (sandbox default: onboarding@resend.dev)
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=your_resend_api_key
# OR
SENDGRID_API_KEY=your_sendgrid_api_key
